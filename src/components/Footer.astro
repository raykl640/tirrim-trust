---
import { Image } from 'astro:assets';
import Logo from './Logo.astro';
import Arrow from './Arrow.astro';
import aicSeal from '../assets/brand/aic-seal.png';
import { site, ministries, schools } from '../data/site';
import { href } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="footer surface-ink topo">
  <div class="container">
    <div class="footer__top">
      <p class="footer__statement">
        <span class="accent">Tirrim</span>, n. <em class="serif">the king post; the cornerstone.</em>{' '}
        Christ-centred ministry to the nomads of Northern Kenya.
      </p>
      <a href={href('/give/')} class="btn btn--give" data-give>Become a partner <Arrow /></a>
    </div>

    <div class="footer__grid">
      <div class="footer__brand">
        <Logo width="9.5rem" />
      </div>

      <nav class="footer__col" aria-label="Ministries">
        <h2 class="footer__heading">Ministries</h2>
        <ul role="list">
          {ministries.map((m) => <li><a href={href(m.path)}>{m.label}</a></li>)}
        </ul>
      </nav>

      <nav class="footer__col" aria-label="Schools">
        <h2 class="footer__heading">Schools</h2>
        <ul role="list">
          {schools.map((s) => <li><a href={href(s.path)}>{s.label}</a></li>)}
        </ul>
      </nav>

      <nav class="footer__col" aria-label="The Trust">
        <h2 class="footer__heading">The Trust</h2>
        <ul role="list">
          <li><a href={href('/about/')}>Who we are</a></li>
          <li><a href={href('/about/#vision')}>Our vision</a></li>
          <li><a href={href('/give/')}>Give</a></li>
          <li><a href={href('/contact/')}>Contact</a></li>
        </ul>
      </nav>

      <div class="footer__col">
        <h2 class="footer__heading">Write to us</h2>
        <address>
          <span class="footer__email-row">
            <a href={`mailto:${site.email}`} class="footer__email">{site.email}</a>
            <button class="footer__copy" data-copy={site.email} aria-label="Copy email address">
              <svg viewBox="0 0 20 20" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="1.5" /><path d="M13 7V4.5A1.5 1.5 0 0 0 11.5 3h-7A1.5 1.5 0 0 0 3 4.5v7A1.5 1.5 0 0 0 4.5 13H7" /></svg>
            </button>
          </span>
          {site.address.map((line) => <span>{line}</span>)}
        </address>
      </div>
    </div>

    <div class="footer__base">
      <div class="footer__aic">
        <Image src={aicSeal} alt="Africa Inland Church seal" width={56} height={56} densities={[1, 2]} />
        <p>The Tirrim Trust is a ministry of<br /> Africa Inland Church, Kenya.</p>
      </div>
      <p class="footer__legal">© {year} The Tirrim Trust · Korr, Marsabit County</p>
    </div>
  </div>
</footer>

<style>
  .footer { padding-block: clamp(4rem, 8vw, 7rem) 2rem; overflow: hidden; }
  .footer__top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: clamp(3rem, 6vw, 5rem);
    border-bottom: 1px solid var(--ink-line);
  }
  .footer__statement {
    max-width: 34ch;
    font-size: var(--step-3);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }
  .footer__statement em { font-weight: 300; letter-spacing: -0.02em; }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.4fr repeat(3, 1fr) 1.3fr;
    gap: 2.5rem;
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .footer__heading {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.5);
    margin-bottom: 1.1rem;
  }
  .footer__col li + li { margin-top: 0.45rem; }
  .footer__col a { font-size: 0.9375rem; transition: color 0.2s; }
  .footer__col a:hover { color: var(--sky); }
  address { display: flex; flex-direction: column; gap: 0.2rem; font-style: normal; font-size: 0.9375rem; color: rgb(255 255 255 / 0.75); }
  .footer__email-row { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.6rem; }
  .footer__email { color: #fff; }
  .footer__copy { width: 1.9rem; height: 1.9rem; display: grid; place-items: center; border-radius: 50%; border: 1px solid var(--ink-line); transition: background 0.2s, color 0.2s; }
  .footer__copy:hover { background: var(--sky); color: var(--ink); border-color: var(--sky); }
  .footer__copy svg { width: 0.85rem; fill: none; stroke: currentColor; stroke-width: 1.6; }

  .footer__base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--ink-line);
    font-size: 0.8125rem;
    color: rgb(255 255 255 / 0.6);
  }
  .footer__aic { display: flex; align-items: center; gap: 1rem; line-height: 1.45; }
  .footer__aic img { width: 3.5rem; height: 3.5rem; border-radius: 50%; }

  @media (max-width: 64rem) {
    .footer__grid { grid-template-columns: repeat(3, 1fr); }
    .footer__brand { grid-column: 1 / -1; }
  }
  @media (max-width: 36rem) {
    .footer__grid { grid-template-columns: 1fr 1fr; }
    .footer__grid > :last-child { grid-column: 1 / -1; }
  }
</style>
