---
import { searchIndex } from '../data/search';
import { href } from '../lib/url';

const entries = searchIndex.map((e) => ({ ...e, path: href(e.path) }));
---

<dialog class="search" id="search" aria-label="Search the site" data-search>
  <div class="search__panel">
    <div class="search__bar">
      <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="6" /><path d="m13 13 5 5" /></svg>
      <input
        type="search"
        placeholder="Search pages, schools and ministries…"
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="true"
        aria-controls="search-results"
        aria-autocomplete="list"
        data-search-input
      />
      <button class="kbd search__esc" data-search-close aria-label="Close search">Esc</button>
    </div>
    <p class="search__hint" data-search-hint>Quick links</p>
    <ul class="search__results" id="search-results" role="listbox" data-search-results></ul>
    <p class="search__foot">
      <span><span class="kbd">↑</span> <span class="kbd">↓</span> to move</span>
      <span><span class="kbd">↵</span> to open</span>
    </p>
  </div>
  <script type="application/json" data-search-index set:html={JSON.stringify(entries)} />
</dialog>

<script>
  type Entry = { title: string; kind: string; path: string; text: string };
  const dialog = document.querySelector<HTMLDialogElement>('[data-search]')!;
  const input = dialog.querySelector<HTMLInputElement>('[data-search-input]')!;
  const list = dialog.querySelector<HTMLUListElement>('[data-search-results]')!;
  const hint = dialog.querySelector<HTMLElement>('[data-search-hint]')!;
  const index: Entry[] = JSON.parse(dialog.querySelector('[data-search-index]')!.textContent!);
  const quick = ['Give', 'Education', 'Who we are', 'Contact us', 'Water'];
  let active = 0;
  let shown: Entry[] = [];

  const score = (e: Entry, terms: string[]) => {
    const title = e.title.toLowerCase();
    const hay = `${title} ${e.kind} ${e.text}`.toLowerCase();
    let s = 0;
    for (const t of terms) {
      if (!hay.includes(t)) return 0;
      s += title.startsWith(t) ? 6 : title.includes(t) ? 3 : 1;
    }
    return s;
  };

  const render = () => {
    const q = input.value.trim().toLowerCase();
    const terms = q.split(/\s+/).filter(Boolean);
    shown = terms.length
      ? index.map((e) => [e, score(e, terms)] as const).filter(([, s]) => s > 0).sort((a, b) => b[1] - a[1]).slice(0, 8).map(([e]) => e)
      : quick.map((t) => index.find((e) => e.title === t)!).filter(Boolean);
    hint.textContent = terms.length ? (shown.length ? `${shown.length} result${shown.length > 1 ? 's' : ''}` : 'No matches. Try “school”, “water” or “give”.') : 'Quick links';
    active = 0;
    list.innerHTML = shown
      .map(
        (e, i) => `<li role="option" id="sr-${i}" aria-selected="${i === 0}"><a href="${e.path}" tabindex="-1">
          <span class="search__kind">${e.kind}</span><span class="search__title">${e.title}</span>
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10h13M11 4.5 16.5 10 11 15.5"/></svg></a></li>`,
      )
      .join('');
    input.setAttribute('aria-activedescendant', shown.length ? 'sr-0' : '');
  };

  const move = (d: number) => {
    if (!shown.length) return;
    active = (active + d + shown.length) % shown.length;
    list.querySelectorAll('[role=option]').forEach((li, i) => li.setAttribute('aria-selected', String(i === active)));
    input.setAttribute('aria-activedescendant', `sr-${active}`);
    list.children[active]?.scrollIntoView({ block: 'nearest' });
  };

  const open = () => {
    if (dialog.open) return;
    input.value = '';
    render();
    dialog.showModal();
    input.focus();
  };

  input.addEventListener('input', render);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
    if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
    if (e.key === 'Enter' && shown[active]) { e.preventDefault(); location.href = shown[active].path; }
    // A search input swallows the first Escape to clear itself; close straight away instead.
    if (e.key === 'Escape') { e.preventDefault(); dialog.close(); }
  });
  list.addEventListener('click', () => dialog.close());
  dialog.querySelector('[data-search-close]')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());

  document.querySelectorAll('[data-search-open]').forEach((b) => b.addEventListener('click', open));
  addEventListener('keydown', (e) => {
    const typing = /INPUT|TEXTAREA|SELECT/.test((e.target as HTMLElement).tagName);
    if ((e.key === 'k' && (e.metaKey || e.ctrlKey)) || (e.key === '/' && !typing)) {
      e.preventDefault();
      open();
    }
  });
</script>

<style>
  .search { width: min(40rem, calc(100vw - 2rem)); margin: min(14vh, 8rem) auto auto; background: transparent; }
  .search__panel {
    background: #fff;
    color: var(--text);
    border-radius: 10px;
    box-shadow: 0 40px 100px -30px rgb(7 21 32 / 0.6);
    overflow: hidden;
  }
  .search[open] .search__panel { animation: pop 0.35s var(--ease); }
  @keyframes pop { from { opacity: 0; transform: translateY(-0.75rem) scale(0.98); } }
  .search__bar { display: flex; align-items: center; gap: 0.85rem; padding: 0 1.1rem; border-bottom: 1px solid var(--line); }
  .search__bar svg { width: 1.15rem; flex: none; fill: none; stroke: var(--muted); stroke-width: 1.7; }
  .search__bar input { flex: 1; min-width: 0; padding: 1.15rem 0; border: 0; outline: none; font-size: 1.0625rem; background: none; }
  .search__bar input::-webkit-search-cancel-button { display: none; }
  .search__esc { cursor: pointer; }
  .search__hint { padding: 0.9rem 1.25rem 0.4rem; font-size: 0.6875rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .search__results { list-style: none; padding: 0 0.5rem 0.5rem; max-height: min(50vh, 24rem); overflow-y: auto; }
  .search__results :global(a) {
    display: grid;
    grid-template-columns: 5.5rem 1fr auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem;
    border-radius: 6px;
  }
  .search__results :global([aria-selected='true'] a), .search__results :global(a:hover) { background: var(--sand); }
  .search__results :global(.search__kind) { font-size: 0.6875rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--blue); }
  .search__results :global(.search__title) { font-size: 0.9375rem; font-weight: 500; }
  .search__results :global(svg) { width: 1rem; fill: none; stroke: currentColor; stroke-width: 1.6; opacity: 0; }
  .search__results :global([aria-selected='true'] svg) { opacity: 1; }
  .search__foot { display: flex; gap: 1.25rem; padding: 0.75rem 1.25rem; border-top: 1px solid var(--line); font-size: 0.75rem; color: var(--muted); }
  @media (max-width: 40rem) {
    .search { margin-top: 1rem; }
    .search__foot { display: none; }
    .search__results :global(a) { grid-template-columns: 1fr auto; }
    .search__results :global(.search__kind) { grid-column: 1; }
    .search__results :global(.search__title) { grid-column: 1; }
    .search__results :global(svg) { grid-row: 1 / span 2; grid-column: 2; }
  }
</style>
