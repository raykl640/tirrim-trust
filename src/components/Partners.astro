---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Limit to these logo file names (without extension). Defaults to all. */
  only?: string[];
  title?: string;
}

const names: Record<string, string> = {
  'genesis-waters': 'Genesis Waters',
  'africa-inland-mission': 'Africa Inland Mission',
  'cornerstone-church': 'Cornerstone Church',
  'samaritans-purse': "Samaritan's Purse",
  'for-the-childrens-sake': "For the Children's Sake",
  'audio-scripture': 'AudioScripture.org Ministries',
  'kamminga-roodvoets': 'Kamminga & Roodvoets Inc.',
  'glory-bee': 'Glory Bee Co., LLC',
};

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/brand/partners/*.png', { eager: true });
const { only, title = 'Ministry partners' } = Astro.props;
const logos = Object.keys(names)
  .filter((key) => !only || only.includes(key))
  .map((key) => ({ name: names[key], src: files[`../assets/brand/partners/${key}.png`].default }));
---

<div class="partners">
  <p class="eyebrow">{title}</p>
  <ul role="list" class="partners__grid">
    {
      logos.map((logo) => (
        <li class="partners__tile">
          <Image src={logo.src} alt={logo.name} height={72} densities={[1, 2]} format="webp" class="partners__logo" />
        </li>
      ))
    }
  </ul>
</div>

<style>
  .partners__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    margin-top: 2rem;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .partners__tile {
    display: grid;
    place-items: center;
    aspect-ratio: 3 / 2;
    padding: 1.75rem;
    background: #fff;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .partners__logo {
    width: auto;
    max-width: 100%;
    max-height: 4.5rem;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.72;
    mix-blend-mode: multiply;
    transition: filter 0.4s, opacity 0.4s, transform 0.5s var(--ease);
  }
  .partners__tile:hover .partners__logo { filter: none; opacity: 1; transform: scale(1.04); }
</style>
