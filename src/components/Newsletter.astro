---
import Arrow from './Arrow.astro';
---

<section class="news section surface-sand" id="prayer">
  <div class="container news__inner">
    <div class="news__text reveal">
      <p class="eyebrow">Monthly newsletter</p>
      <h2 class="h2">Partner in prayer.</h2>
      <p class="prose news__body">
        <strong>Just like being there.</strong> Without the bugs and snakes, the goats and camels, or the
        scorching temperatures. Subscribe and go with us to reach the nomads of Northern Kenya with the life-giving
        water from the Bible.
      </p>
    </div>

    <form class="form reveal" data-demo>
      <div class="form__row">
        <label class="field">
          <span>First name</span>
          <input name="first" autocomplete="given-name" required />
        </label>
        <label class="field">
          <span>Last name</span>
          <input name="last" autocomplete="family-name" required />
        </label>
      </div>
      <label class="field">
        <span>Email</span>
        <input name="email" type="email" autocomplete="email" required />
      </label>
      <button class="btn btn--blue" type="submit">Subscribe <Arrow /></button>
      <p class="form__status" data-status role="status" hidden>
        Thank you. This demo form isn’t connected yet, so nothing was sent.
      </p>
    </form>
  </div>
</section>

<style>
  .news__inner {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2.4vw, 2.5rem);
    row-gap: 3rem;
    align-items: end;
  }
  .news__text { grid-column: 1 / span 6; }
  .news__text .h2 { margin-block: 1.5rem; }
  .news__body { color: var(--muted); max-width: 36ch; }
  .form { grid-column: 8 / -1; }
  @media (max-width: 56rem) {
    .news__text, .form { grid-column: 1 / -1; }
  }
</style>
