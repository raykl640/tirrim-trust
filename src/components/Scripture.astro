---
interface Props {
  quote: string;
  cite: string;
  tone?: 'paper' | 'ink' | 'blue';
}
const { quote, cite, tone = 'paper' } = Astro.props;
---

<section class:list={['scripture section', `surface-${tone}`]}>
  <figure class="container scripture__inner reveal">
    <svg class="scripture__mark" viewBox="0 0 48 36" aria-hidden="true">
      <path d="M0 36V22C0 9 7 2 20 0l2 5c-7 2-11 6-11 13h9v18zm26 0V22C26 9 33 2 46 0l2 5c-7 2-11 6-11 13h9v18z" />
    </svg>
    <blockquote>
      <p>{quote}</p>
    </blockquote>
    <figcaption class="eyebrow">{cite}</figcaption>
  </figure>
</section>

<style>
  .surface-paper { background: var(--paper); }
  .scripture__inner { max-width: 62rem; margin-inline: auto; }
  .scripture__mark { width: clamp(2.25rem, 4vw, 3rem); fill: var(--red); margin-bottom: 2rem; }
  blockquote p {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: var(--step-4);
    line-height: 1.08;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  figcaption { margin-top: 2.25rem; }
  .surface-blue .scripture__mark { fill: #fff; }
  .surface-blue figcaption::before { background: #fff; }
</style>
