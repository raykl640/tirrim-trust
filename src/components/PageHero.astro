---
import Photo from './Photo.astro';
import type { Photo as PhotoType } from '../data/photos';
import { href } from '../lib/url';

interface Props {
  eyebrow: string;
  /** May contain inline markup such as <em> or <br>. */
  title: string;
  lede?: string;
  photo?: PhotoType;
  /** "wide": landscape photograph straddling the hero's bottom edge. "split": portrait dome beside the title. */
  variant?: 'wide' | 'split';
  position?: string;
  caption?: string;
  /** Desktop aspect ratio of a wide photograph; match panoramic sources to avoid upscaling. */
  aspect?: string;
  /** Short name for the breadcrumb; defaults to the title without markup. */
  crumb?: string;
}

const { eyebrow, title, lede, photo, variant = 'wide', position, caption, aspect = '21 / 9', crumb } = Astro.props;

// Breadcrumbs: Home › (Education ›) this page.
const here = crumb ?? title.replace(/<br\s*\/?>/g, ' ').replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '');
const trail = [
  { label: 'Home', path: '/' },
  ...(path.startsWith('/education/') && path !== '/education/' ? [{ label: 'Education', path: '/education/' }] : []),
  { label: here, path },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: t.label, item: new URL(href(t.path), Astro.site).href })),
};
---

<section class:list={['ph surface-ink topo', `ph--${variant}`, { 'ph--bare': !photo }]}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="container ph__inner">
    <nav class="crumbs rise" aria-label="Breadcrumb">
      <ol role="list">
        {
          trail.map((t, i) => (
            <li>
              {i < trail.length - 1 ? <a href={href(t.path)}>{t.label}</a> : <span aria-current="page">{t.label}</span>}
            </li>
          ))
        }
      </ol>
    </nav>
    <div class="ph__text">
      <p class="eyebrow rise" style="--d:0">{eyebrow}</p>
      <h1 class="h1 ph__title rise" style="--d:1" set:html={title} />
      {lede && <p class="lede ph__lede rise" style="--d:2">{lede}</p>}
    </div>

    {
      photo && variant === 'split' && (
        <figure class="ph__split">
          <div class="media dome ph__dome unveil" data-zoom>
            <Photo photo={photo} priority sizes="(min-width: 64rem) 38vw, 90vw" position={position} />
          </div>
          {caption && <figcaption class="caption">{caption}</figcaption>}
        </figure>
      )
    }
  </div>

  {
    photo && variant === 'wide' && (
      <figure class="container ph__wide">
        <div class="media ph__media unveil" style={`--ar: ${aspect}`} data-zoom>
          <Photo photo={photo} priority sizes="(min-width: 90rem) 1360px, 100vw" position={position} />
        </div>
        {caption && <figcaption class="caption">{caption}</figcaption>}
      </figure>
    )
  }
</section>

<style>
  .ph { padding-top: calc(var(--header-h) + clamp(1.5rem, 4vw, 3rem)); position: relative; }
  .ph--wide:not(.ph--bare).topo::before { bottom: clamp(6rem, 16vw, 15rem); }
  /* The horizon from the homepage, carried through every page. */
  .ph::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--horizon, 0);
    height: 1px;
    background: var(--cyan);
    opacity: 0.75;
    pointer-events: none;
  }
  .ph--wide:not(.ph--bare) { --horizon: clamp(6rem, 16vw, 15rem); }
  .ph--wide:not(.ph--bare)::after { z-index: 0; }
  .ph__wide { position: relative; z-index: 1; }
  .crumbs { margin-bottom: clamp(2rem, 5vw, 4rem); }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 0.5rem; font-size: 0.8125rem; color: rgb(255 255 255 / 0.6); }
  .crumbs li { display: flex; align-items: center; gap: 0.5rem; }
  .crumbs li + li::before { content: ''; width: 0.3rem; height: 0.4rem; background: var(--cyan); clip-path: polygon(0 0, 100% 50%, 0 100%); }
  .crumbs a { transition: color 0.2s; }
  .crumbs a:hover { color: #fff; }
  .crumbs [aria-current] { color: #fff; }
  .ph--bare { padding-bottom: clamp(4rem, 8vw, 7rem); }
  .ph__inner { display: grid; gap: 2rem; }
  .ph__text { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(1rem, 2.4vw, 2.5rem); row-gap: 1.75rem; align-items: end; }
  .ph__text .eyebrow { grid-column: 1 / -1; }
  .ph__title { grid-column: 1 / span 8; }
  .ph__title :global(em) { font-family: var(--serif); font-weight: 300; font-style: italic; letter-spacing: -0.03em; }
  .ph__lede { grid-column: 9 / -1; color: rgb(255 255 255 / 0.8); font-size: var(--step-1); padding-bottom: 0.4em; }

  /* Wide: the photograph straddles the edge between ink and page. */
  .ph--wide:not(.ph--bare) {
    background: linear-gradient(var(--ink) 0 calc(100% - clamp(6rem, 16vw, 15rem)), var(--paper) 0);
  }
  .ph__wide { margin-top: clamp(3rem, 6vw, 5rem); }
  .ph__media { aspect-ratio: var(--ar); border-radius: var(--radius); }
  .ph__wide .caption { color: var(--muted); }

  /* Split: title left, a tall dome-shaped portrait right. */
  /* A single manyatta standing on the horizon. */
  .ph--split { padding-bottom: 0; }
  .ph--split .ph__text { padding-bottom: clamp(3rem, 6vw, 5rem); }
  .ph--split .ph__inner { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(1rem, 2.4vw, 2.5rem); align-items: end; }
  .ph--split .ph__text { grid-column: 1 / span 7; grid-template-columns: 1fr; }
  .ph--split .ph__title, .ph--split .ph__lede { grid-column: 1 / -1; }
  .ph--split .crumbs { grid-column: 1 / -1; }
  .ph--split .ph__lede { max-width: 34ch; }
  .ph__split { grid-column: 9 / -1; }
  .ph__dome { aspect-ratio: 4 / 5; border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
  .ph__split { align-self: end; }
  .ph__split .caption { display: none; }

  @media (max-width: 64rem) {
    .ph__title { grid-column: 1 / -1; }
    .ph__lede { grid-column: 1 / span 10; }
    .ph--split .ph__text, .ph__split { grid-column: 1 / -1; }
    .ph__split { max-width: 28rem; }
    .ph__media { aspect-ratio: 16 / 10; }
  }
  @media (max-width: 40rem) {
    .ph__lede { grid-column: 1 / -1; }
    .ph__dome { aspect-ratio: 5 / 4; border-radius: 50% 50% 0 0 / 46% 46% 0 0; }
    .ph__media { aspect-ratio: 4 / 3; }
  }
</style>
