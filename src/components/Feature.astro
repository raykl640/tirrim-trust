---
import Photo from './Photo.astro';
import type { Photo as PhotoType } from '../data/photos';

interface Props {
  photo: PhotoType;
  title: string;
  eyebrow?: string;
  /** Put the photograph on the right. */
  flip?: boolean;
  position?: string;
  tone?: 'paper' | 'mist';
  /** Anchor for in-page navigation. */
  id?: string;
}

const { photo, title, eyebrow, flip = false, position, tone = 'paper', id } = Astro.props;
---

<article class:list={['feature', { 'feature--flip': flip }, `feature--${tone}`]} id={id}>
  <div class="media feature__media reveal-media" data-zoom>
    <Photo photo={photo} sizes="(min-width: 64rem) 58vw, 100vw" position={position} />
  </div>
  <div class="feature__card reveal">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 class="h3 feature__title">{title}</h2>
    <div class="prose feature__body"><slot /></div>
  </div>
</article>

<style>
  .feature {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2.4vw, 2.5rem);
    align-items: center;
  }
  .feature + :global(.feature) { margin-top: clamp(3.5rem, 8vw, 7rem); }
  .feature__media { grid-column: 1 / span 7; grid-row: 1; aspect-ratio: 5 / 4; border-radius: var(--radius); }
  .feature__card {
    grid-column: 7 / -1;
    grid-row: 1;
    position: relative;
    z-index: 1;
    margin-top: clamp(4rem, 11vw, 9rem);
    padding: clamp(1.5rem, 3.2vw, 2.75rem);
    background: var(--paper);
    border-radius: var(--radius);
    box-shadow: 0 30px 80px -40px rgb(4 26 54 / 0.25);
  }
  .feature--mist .feature__card { background: var(--mist); box-shadow: none; }
  .feature__card .eyebrow { margin-bottom: 1.25rem; color: var(--navy); }
  .feature__title { margin-bottom: 1rem; font-size: var(--step-3); }
  .feature__body { font-size: 1.0625rem; color: var(--muted); }

  .feature--flip .feature__media { grid-column: 6 / -1; }
  .feature--flip .feature__card { grid-column: 1 / span 6; }

  @media (max-width: 52rem) {
    .feature { display: block; }
    .feature__card { margin: -4rem 1rem 0; }
  }
</style>
