---
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/newsreader/300-italic.css';
import '@fontsource/newsreader/400.css';
import '@fontsource/newsreader/400-italic.css';
import '@fontsource/newsreader/600.css';
import '../styles/global.css';

import poppins500 from '@fontsource/poppins/files/poppins-latin-500-normal.woff2?url';
import poppins400 from '@fontsource/poppins/files/poppins-latin-400-normal.woff2?url';
import poppins600 from '@fontsource/poppins/files/poppins-latin-600-normal.woff2?url';
import serif400 from '@fontsource/newsreader/files/newsreader-latin-400-normal.woff2?url';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Search from '../components/Search.astro';
import GiveDrawer from '../components/GiveDrawer.astro';
import Lightbox from '../components/Lightbox.astro';
import { site } from '../data/site';
import { photos } from '../data/photos';
import { href } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({ src: photos['school-gate'].src, width: 1200, height: 630, format: 'jpg', quality: 78 });
---

<!doctype html>
<html lang="en-KE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#08131d" />
    <link rel="preload" href={poppins500} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={poppins400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={poppins600} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serif400} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(og.src, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <button class="totop" aria-label="Back to top" data-totop>
      <svg class="totop__ring" viewBox="0 0 48 48" aria-hidden="true">
        <circle cx="24" cy="24" r="22" pathLength="100" />
        <circle cx="24" cy="24" r="22" pathLength="100" data-totop-progress />
      </svg>
      <svg class="totop__arrow" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 16V4M4.5 9 10 3.5 15.5 9" /></svg>
    </button>
    <div class="toast" role="status" aria-live="polite" data-toast></div>

    <Search />
    <GiveDrawer />
    <Lightbox />

    <script>
      // Header: solid once the page scrolls, tucks away on the way down.
      const header = document.querySelector<HTMLElement>('[data-header]')!;
      let lastY = window.scrollY;
      const onScroll = () => {
        const y = window.scrollY;
        header.toggleAttribute('data-scrolled', y > 24);
        header.toggleAttribute('data-hidden', y > 480 && y > lastY);
        lastY = y;
      };
      // Back to top, with a ring that fills as you read.
      const totop = document.querySelector<HTMLElement>('[data-totop]')!;
      const ring = totop.querySelector<SVGCircleElement>('[data-totop-progress]')!;
      const onProgress = () => {
        const max = document.documentElement.scrollHeight - innerHeight;
        ring.style.strokeDashoffset = String(100 - (max > 0 ? (scrollY / max) * 100 : 0));
        totop.toggleAttribute('data-show', scrollY > innerHeight * 0.9);
      };
      totop.addEventListener('click', () => scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' }));

      onScroll();
      onProgress();
      addEventListener('scroll', () => { onScroll(); onProgress(); }, { passive: true });

      // Show the right shortcut for the platform.
      if (/Mac|iPhone|iPad/.test(navigator.platform)) document.querySelectorAll('[data-kbd]').forEach((k) => (k.textContent = '⌘K'));

      // Toasts and copy-to-clipboard.
      const toastEl = document.querySelector<HTMLElement>('[data-toast]')!;
      let toastTimer = 0;
      const toast = (msg: string) => {
        toastEl.textContent = msg;
        toastEl.toggleAttribute('data-show', true);
        clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => toastEl.removeAttribute('data-show'), 2600);
      };
      document.addEventListener('click', async (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-copy]');
        if (!btn) return;
        e.preventDefault();
        try {
          await navigator.clipboard.writeText(btn.dataset.copy!);
          toast(`Copied ${btn.dataset.copy}`);
        } catch {
          toast('Copy failed. Please select and copy manually.');
        }
      });

      // Mobile menu.
      const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
      const setOpen = (open: boolean) => {
        header.toggleAttribute('data-open', open);
        toggle.setAttribute('aria-expanded', String(open));
        document.documentElement.style.overflow = open ? 'hidden' : '';
      };
      toggle.addEventListener('click', () => setOpen(!header.hasAttribute('data-open')));
      addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
      matchMedia('(min-width: 68.01rem)').addEventListener('change', (e) => e.matches && setOpen(false));

      // Demo forms: friendly inline validation; nothing is sent anywhere yet.
      const messages: Record<string, string> = {
        valueMissing: 'This field is required.',
        typeMismatch: 'Please enter a valid email address, like name@example.com.',
      };
      const check = (input: HTMLInputElement | HTMLTextAreaElement) => {
        const field = input.closest<HTMLElement>('.field');
        if (!field) return true;
        let err = field.querySelector<HTMLElement>('.field__error');
        if (!err) {
          err = Object.assign(document.createElement('span'), { className: 'field__error', id: `${input.name}-err-${Math.random().toString(36).slice(2, 7)}` });
          field.append(err);
          input.setAttribute('aria-describedby', err.id);
        }
        const key = (['valueMissing', 'typeMismatch'] as const).find((k) => input.validity[k]);
        err.textContent = key ? messages[key] : '';
        field.toggleAttribute('data-invalid', !!key);
        input.setAttribute('aria-invalid', String(!!key));
        return !key;
      };
      document.querySelectorAll<HTMLFormElement>('form[data-demo]').forEach((form) => {
        form.noValidate = true;
        const inputs = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea')];
        inputs.forEach((i) => {
          i.addEventListener('blur', () => i.value && check(i));
          i.addEventListener('input', () => i.closest('.field')?.hasAttribute('data-invalid') && check(i));
        });
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          const bad = inputs.filter((i) => !check(i));
          if (bad.length) return bad[0].focus();
          const status = form.querySelector<HTMLElement>('[data-status]');
          if (status) status.hidden = false;
          toast('Thank you. This demo form isn’t connected yet.');
          form.reset();
        });
      });
    </script>
  </body>
</html>

<style is:global>
  .totop {
    position: fixed;
    right: clamp(1rem, 2.5vw, 2rem);
    bottom: clamp(1rem, 2.5vw, 2rem);
    z-index: 45;
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    box-shadow: 0 12px 30px -12px rgb(7 21 32 / 0.5);
    opacity: 0;
    visibility: hidden;
    transform: translateY(0.75rem);
    transition: opacity 0.3s, transform 0.4s var(--ease), visibility 0.3s, background 0.3s;
  }
  .totop[data-show] { opacity: 1; visibility: visible; transform: none; }
  .totop:hover { background: var(--blue); }
  .totop > svg { grid-area: 1 / 1; }
  .totop__ring { width: 100%; height: 100%; rotate: -90deg; fill: none; stroke-width: 2; }
  .totop__ring circle:first-child { stroke: rgb(255 255 255 / 0.15); }
  .totop__ring circle:last-child { stroke: var(--cyan); stroke-dasharray: 100; stroke-dashoffset: 100; stroke-linecap: round; }
  .totop__arrow { width: 1rem; fill: none; stroke: currentColor; stroke-width: 1.7; }

  .toast {
    position: fixed;
    left: 50%;
    bottom: 1.5rem;
    z-index: 60;
    max-width: calc(100vw - 2rem);
    padding: 0.8rem 1.2rem;
    border-radius: 99px;
    background: var(--ink);
    color: #fff;
    font-size: 0.875rem;
    box-shadow: 0 16px 40px -16px rgb(7 21 32 / 0.6);
    translate: -50% 1rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s, translate 0.4s var(--ease);
  }
  .toast[data-show] { opacity: 1; translate: -50% 0; }
  .header { view-transition-name: site-header; }
</style>
